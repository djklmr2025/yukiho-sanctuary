<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>La Bóveda de los Frágiles · Yukiho en Cancún (ARKAIOS)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400;1,600&display=swap" rel="stylesheet">
<!-- Google Identity Services -->
<script src="https://accounts.google.com/gsi/client" async defer></script>
<style>
  :root {
    --bg-dark: #07090e;
    --bg-card: rgba(15, 19, 29, 0.9);
    --border-color: rgba(217, 119, 6, 0.35);
    --accent-amber: #f59e0b;
    --accent-gold: #fbbf24;
    --accent-rose: #f43f5e;
    --accent-teal: #14b8a6;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --text-dim: #64748b;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background-color: var(--bg-dark);
    background-image: 
      radial-gradient(circle at 80% 15%, rgba(245, 158, 11, 0.08) 0%, transparent 45%),
      radial-gradient(circle at 15% 85%, rgba(20, 184, 166, 0.08) 0%, transparent 45%),
      linear-gradient(rgba(7, 9, 14, 0.96), rgba(7, 9, 14, 0.96));
    color: var(--text-main);
    font-family: 'Inter', system-ui, sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* TOP NAVBAR */
  header {
    background: rgba(10, 13, 20, 0.95);
    border-bottom: 1px solid var(--border-color);
    padding: 10px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-logo {
    background: linear-gradient(135deg, #d97706, #b45309);
    color: #fff;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.5px;
    padding: 5px 10px;
    border-radius: 6px;
  }
  .brand-text h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
  }
  .brand-text small { display: block; font-size: 11px; color: var(--text-muted); }

  .user-nav {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nav-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #f1f5f9;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s;
  }
  .nav-btn:hover {
    background: rgba(245, 158, 11, 0.15);
    border-color: var(--accent-amber);
    color: #fff;
  }

  .user-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 4px 10px;
    border-radius: 20px;
    cursor: pointer;
  }
  .user-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
  }
  .user-name {
    font-size: 12px;
    font-weight: 600;
    color: #fff;
  }

  /* MAIN LAYOUT */
  main {
    flex: 1;
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 20px;
    display: grid;
    grid-template-columns: 1fr 460px;
    gap: 20px;
  }
  @media(max-width: 1024px) { main { grid-template-columns: 1fr; } }

  .story-col { display: flex; flex-direction: column; gap: 16px; }

  /* METRICS & TRACKER */
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 8px;
  }
  .stat-pill {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 8px 12px;
  }
  .stat-pill small {
    font-size: 10px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
  }
  .stat-pill strong {
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 2px;
  }

  /* DIALOGUE & NARRATION */
  .dialog-box {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 22px;
    min-height: 400px;
    max-height: 500px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
  .dialog-box::-webkit-scrollbar { width: 6px; }
  .dialog-box::-webkit-scrollbar-thumb { background: rgba(245, 158, 11, 0.3); border-radius: 4px; }

  .msg-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    animation: fadeIn 0.3s ease;
  }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

  .msg-header {
    font-size: 11px;
    color: var(--accent-amber);
    font-weight: 600;
    display: flex;
    justify-content: space-between;
  }
  .narration {
    font-size: 14.5px;
    line-height: 1.7;
    color: #cbd5e1;
  }
  .quote-yukiho {
    background: rgba(245, 158, 11, 0.08);
    border-left: 3px solid var(--accent-amber);
    padding: 12px 18px;
    border-radius: 0 10px 10px 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 15.5px;
    font-style: italic;
    line-height: 1.65;
    color: #fff;
  }
  .speaker-label {
    font-family: 'Inter', sans-serif;
    font-style: normal;
    font-weight: 700;
    font-size: 12px;
    color: var(--accent-amber);
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .player-quote {
    background: rgba(20, 184, 166, 0.08);
    border-left: 3px solid var(--accent-teal);
    padding: 8px 14px;
    border-radius: 0 8px 8px 0;
    font-size: 13.5px;
    color: #99f6e4;
  }

  /* ACTIONS PANEL */
  .control-panel {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .panel-title {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }
  .options-grid { display: flex; flex-direction: column; gap: 8px; }
  .opt-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    padding: 12px 16px;
    border-radius: 10px;
    text-align: left;
    font-size: 13.5px;
    line-height: 1.4;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .opt-btn:hover {
    background: rgba(245, 158, 11, 0.14);
    border-color: var(--accent-amber);
    color: #fff;
    transform: translateX(4px);
  }
  .opt-btn span.num {
    background: rgba(245, 158, 11, 0.25);
    color: var(--accent-amber);
    font-weight: 700;
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .custom-action-bar { display: flex; gap: 8px; }
  .custom-input {
    flex: 1;
    background: #090c14;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 13.5px;
    color: #fff;
    outline: none;
  }
  .custom-input:focus { border-color: var(--accent-amber); }
  .btn-submit {
    background: linear-gradient(135deg, #d97706, #b45309);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 0 18px;
    font-weight: 600;
    font-size: 13.5px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-submit:hover { opacity: 0.9; }

  /* RIGHT: VISUAL & UNLOCKABLES */
  .visual-col { display: flex; flex-direction: column; gap: 14px; }
  .visual-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(0,0,0,0.6);
  }
  .image-wrapper {
    width: 100%;
    height: 480px;
    background: #000;
    position: relative;
    overflow: hidden;
  }
  .main-art {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: opacity 0.4s ease;
  }
  .art-info-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(7, 9, 14, 0.96) 0%, rgba(7, 9, 14, 0.6) 60%, transparent 100%);
    padding: 18px;
  }
  .art-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 22px;
    font-weight: 700;
    color: #fff;
  }
  .art-sub { font-size: 12px; color: var(--accent-amber); margin-top: 2px; }
  .art-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .tag {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 11px;
    padding: 2px 7px;
    border-radius: 6px;
    color: #cbd5e1;
  }

  /* DESBLOQUEABLES DE USUARIO */
  .unlocks-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .unlock-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .unlock-item {
    height: 64px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    overflow: hidden;
    position: relative;
    cursor: pointer;
    background: #000;
  }
  .unlock-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s;
  }
  .unlock-item.locked img { filter: grayscale(1) blur(4px); opacity: 0.35; }
  .unlock-item .lock-badge {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    font-size: 14px;
  }
  .unlock-item:hover:not(.locked) img { transform: scale(1.08); }

  /* MODALES */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .modal-box {
    background: #111522;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    max-width: 540px;
    width: 100%;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
</style>
</head>
<body>

<header>
  <div class="brand">
    <span class="brand-logo">ARKAIOS</span>
    <div class="brand-text">
      <h1>La Bóveda de los Frágiles</h1>
      <small>Novela Visual Clásica 80s · Cancún, México</small>
    </div>
  </div>

  <div class="user-nav">
    <button class="nav-btn" id="btnAudio" onclick="toggleRainAudio()">
      <span id="audioIcon">🌧️</span> <span id="audioTxt">Lluvia</span>
    </button>
    <button class="nav-btn" onclick="openUserModal()">
      📁 Mi Historial / .log
    </button>
    
    <!-- GOOGLE LOGIN / PROFILE CONTAINER -->
    <div id="googleBtnContainer">
      <div id="g_id_onload"
           data-client_id="756809656093-tfe1n5jhsmkob7jev43m3u6rg5kou8c1.apps.googleusercontent.com"
           data-callback="handleGoogleLogin"
           data-auto_prompt="false">
      </div>
      <div class="g_id_signin" data-type="standard" data-size="medium" data-theme="dark" data-text="signin_with"></div>
    </div>

    <div class="user-badge" id="userProfileBadge" style="display:none;" onclick="openUserModal()">
      <img src="" id="userProfilePic" class="user-avatar" alt="Avatar">
      <span class="user-name" id="userProfileName">Usuario</span>
    </div>
  </div>
</header>

<main>
  <!-- STORY & CHOICES -->
  <div class="story-col">
    <!-- STATS -->
    <div class="stats-bar">
      <div class="stat-pill">
        <small>Escenario</small>
        <strong>📍 Cancún · Departamento</strong>
      </div>
      <div class="stat-pill">
        <small>Vínculo con Yukiho</small>
        <strong id="statBond" style="color:var(--accent-amber);">🛡️ Confianza (20%)</strong>
      </div>
      <div class="stat-pill">
        <small>Estado</small>
        <strong id="statStatus">☕ Saliendo del baño</strong>
      </div>
      <div class="stat-pill">
        <small>Usuario Activo</small>
        <strong id="statUser">👤 Local / Operador</strong>
      </div>
    </div>

    <!-- DIALOG BOX -->
    <div class="dialog-box" id="dialogLog"></div>

    <!-- CONTROLS -->
    <div class="control-panel">
      <div class="panel-title">¿Qué le respondes a Yukiho, Saúl?</div>
      <div class="options-grid" id="optionsContainer"></div>
      <div class="custom-action-bar">
        <input type="text" class="custom-input" id="customInput" placeholder="O escribe tu propia respuesta..." onkeydown="if(event.key==='Enter') submitCustomAction()">
        <button class="btn-submit" id="btnSend" onclick="submitCustomAction()">
          Responder ▶
        </button>
      </div>
    </div>
  </div>

  <!-- VISUAL & UNLOCKABLES -->
  <div class="visual-col">
    <div class="visual-card">
      <div class="image-wrapper">
        <img class="main-art" id="mainArt" src="assets/images/yukiho_cover.jpg" alt="Yukiho">
        <div class="art-info-overlay">
          <div class="art-title">YUKIHO</div>
          <div class="art-sub">Joven de 19 años · Cómic Oficial STILL GAMES MX</div>
          <div class="art-tags">
            <span class="tag">🌧️ 80s Classic Romance</span>
            <span class="tag">👁️ Ojos Verdes Melancólicos</span>
            <span class="tag">📖 Cuaderno Secreto</span>
            <span class="tag">🇲🇽 Noche en Cancún</span>
          </div>
        </div>
      </div>
    </div>

    <!-- RECUERDOS Y ARCHIVOS DESBLOQUEABLES -->
    <div class="unlocks-card">
      <div class="panel-title">🏆 Archivos Desbloqueados de tu Partida:</div>
      <div class="unlock-grid" id="unlockGrid">
        <div class="unlock-item" onclick="viewUnlock('yukiho_cover.jpg', 'Ilustración Oficial STILL GAMES MX')">
          <img src="assets/images/yukiho_cover.jpg" alt="Portada Oficial">
        </div>
        <div class="unlock-item" id="unlock1" onclick="viewUnlock('apartment_doorway.png', 'Entrada al Refugio de Cancún')">
          <img src="assets/images/apartment_doorway.png" alt="Entrada">
          <div class="lock-badge" id="badge1">🔒 30%</div>
        </div>
        <div class="unlock-item" id="unlock2" onclick="viewUnlock('yukiho_default.png', 'La Calidez del Té de Canela')">
          <img src="assets/images/yukiho_default.png" alt="Té">
          <div class="lock-badge" id="badge2">🔒 50%</div>
        </div>
        <div class="unlock-item" id="unlock3" onclick="viewUnlock('yukiho_portrait.png', 'El Cuaderno Secreto de Poemas')">
          <img src="assets/images/yukiho_portrait.png" alt="Cuaderno">
          <div class="lock-badge" id="badge3">🔒 75%</div>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- MODAL: PERFIL, HISTORIAL Y .LOG -->
<div class="modal-overlay" id="userModal">
  <div class="modal-box">
    <h3 style="font-family:'Playfair Display', serif; color:#fff; font-size:20px;">
      📁 Expediente de Usuario & Bitácora (.log)
    </h3>
    <div style="font-size:13px; color:var(--text-muted); line-height:1.5;">
      Cada decisión que tomas como Saúl queda registrada con marca de tiempo en tu historial personal cifrado de ARKAIOS.
    </div>

    <div style="background:#090c14; border:1px solid rgba(255,255,255,0.08); border-radius:10px; padding:12px; font-size:13px;">
      <div><strong>Usuario actual:</strong> <span id="modalUserDisplay">Operador Local</span></div>
      <div><strong>Decisiones registradas:</strong> <span id="modalTurnCount">0 turnos</span></div>
      <div><strong>Vínculo alcanzado:</strong> <span id="modalBondDisplay">20%</span></div>
      <div><strong>Almacenamiento:</strong> <span style="color:var(--accent-teal);">Google Identity / SaaS Ready</span></div>
    </div>

    <div style="display:flex; flex-direction:column; gap:8px;">
      <button class="nav-btn" style="justify-content:center; background:var(--accent-amber); color:#000; font-weight:700;" onclick="downloadPlayerLog()">
        📥 Descargar Mi Bitácora (.log / .json)
      </button>
      <button class="nav-btn" style="justify-content:center;" onclick="copyPlayerReport()">
        📋 Copiar Resumen de Mi Partida
      </button>
      <button class="nav-btn" style="justify-content:center; color:var(--accent-rose);" onclick="resetCurrentUserStory()">
        🔄 Reiniciar Mi Partida Personal
      </button>
    </div>

    <div style="display:flex; justify-content:flex-end;">
      <button class="nav-btn" onclick="closeUserModal()">Cerrar</button>
    </div>
  </div>
</div>

<audio id="ambientAudio" loop preload="none">
  <source src="assets/audio/rain.mp3" type="audio/mpeg">
</audio>

<script>
// ── GESTIÓN DE CUENTAS DE USUARIO ─────────────────────────────
let currentUser = {
  id: "local_guest",
  name: "Operador Local",
  email: "local@arkaios.vault",
  picture: "https://api.dicebear.com/7.x/bottts/svg?seed=Arkaios"
};

let userState = {
  chapter: 1,
  bondPercent: 20,
  history: [],
  busy: false,
  unlocked: ['yukiho_cover.jpg']
};

// ── LORE OFICIAL (LA BÓVEDA DE LOS FRÁGILES - CANCÚN) ──────────
const SYSTEM_LORE = `Eres el narrador y la voz de Yukiho para la novela visual clásica dramática "La Bóveda de los Frágiles" dentro del universo ARKAIOS.

AMBIENTACIÓN Y GÉNERO:
- Romance clásico / drama maduro japonés estilo años 80s (City Pop, anime clásico adulto).
- Lugar: Cancún, México. En el interior de un departamento cálido y acogedor durante una fuerte noche de lluvia tropical caribeña.
- No es ciencia ficción cibernética; es una historia humana, íntima, de sanación, respeto y conexión emocional.

PERSONAJES:
1. YUKIHO:
   - Joven mujer japonesa de 19 años de edad (adulta). Jamás tratarla como una niña.
   - Pelo negro largo, ojos verdes grandes y nostálgicos.
   - Lleva una playera holgada limpia y un short que le prestó Saúl tras salir del baño caliente.
   - Superviviente de abandono y soledad; frágil, tímida, de voz suave y dulce pero con dignidad y gratitud profunda.
   - Oculta un cuaderno con poemas y pensamientos sobre el cielo antes de la tormenta.
2. SAÚL (El Jugador / djklmr):
   - Hombre adulto, maduro, protector, marcado por una dolorosa separación familiar.
   - Trata a Yukiho con respeto absoluto, sin sobrepasarse, ofreciéndole té caliente de canela, comida y refugio seguro para que deje de tener frío.

REGLAS DE RESPUESTA:
Responde SIEMPRE en JSON estricto:
{
  "narration": "Narración en tercera persona (español) de la atmósfera íntima del departamento de Cancún, la lluvia contra el cristal, el té caliente y los gestos delicados de Yukiho.",
  "dialogue": "Palabras exactas de Yukiho (en español, con voz suave, sincera, reflexiva).",
  "bond_change": número entre 5 y 15 (aumento de confianza y cercanía afectiva),
  "status_text": "Breve estado de Yukiho (ej: Bebiendo té caliente, Sonrisa tímida, Mirando la lluvia)",
  "options": [
    "Opción 1 de respuesta reflexiva o atenta para Saúl",
    "Opción 2 de respuesta hogareña o protectora",
    "Opción 3 de pregunta íntima sobre su pasado o su cuaderno"
  ]
}`;

const SCENE_1 = {
  narration: "Afuera, la lluvia torrencial de Cancún golpea los cristales del balcón en un compás rítmico e incesante. El departamento huele a té caliente de canela y calma. Tras haberla rescatado empapada de las escaleras exteriores y prestarle ropa limpia y seca (una playera holgada de algodón y una toalla suave), Yukiho sale despacio del baño. El vapor aún acaricia su cabello negro y sus ojos verdes te miran con una mezcla de desconcierto y una profunda necesidad de paz.",
  dialogue: "«Ya no llueve aquí adentro... ¿Tú... eres quien me trajo hasta aquí? Llevaba tanto tiempo con frío que pensé que nunca dejaría de temblar. ¿De verdad puedo quedarme aquí esta noche?»",
  bond_change: 0,
  status_text: "Abrigada con tu playera",
  options: [
    "Servirle una taza de té de canela: 'Toma esto caliente, Yukiho. Estás a salvo en mi casa. Puedes quedarte todo el tiempo que necesites.'",
    "Tranquilizarla con voz calmada: 'Llevabas mucho tiempo bajo la tormenta. Descansa en el sofá, nadie va a molestarte ni a hacerte daño aquí.'",
    "Preguntarle con respeto: '¿Te sientes mejor después del baño caliente? Vi que guardas con mucho cuidado un pequeño cuaderno entre tus cosas.'"
  ]
};

// ── INICIALIZACIÓN ────────────────────────────────────────────
window.addEventListener('DOMContentLoaded', () => {
  // Cargar usuario guardado
  const savedUser = localStorage.getItem('arkaios_current_user');
  if (savedUser) {
    try {
      currentUser = JSON.parse(savedUser);
      updateUserUI();
    } catch(e) {}
  }
  loadUserStory();
});

function loadUserStory() {
  const storeKey = `boveda_fragiles_save_${currentUser.id}`;
  const saved = localStorage.getItem(storeKey);
  if (saved) {
    try {
      userState = JSON.parse(saved);
      renderAllHistory();
      checkUnlocks();
      return;
    } catch(e) {}
  }
  // Nueva partida
  userState = { chapter: 1, bondPercent: 20, history: [], busy: false, unlocked: ['yukiho_cover.jpg'] };
  document.getElementById('dialogLog').innerHTML = '';
  applyScene(SCENE_1, null);
}

function saveUserStory() {
  const storeKey = `boveda_fragiles_save_${currentUser.id}`;
  localStorage.setItem(storeKey, JSON.stringify(userState));
  checkUnlocks();
}

// ── GOOGLE LOGIN CALLBACK ─────────────────────────────────────
function handleGoogleLogin(response) {
  try {
    const payload = decodeJwt(response.credential);
    currentUser = {
      id: payload.sub,
      name: payload.name || "Usuario Google",
      email: payload.email,
      picture: payload.picture || ""
    };
    localStorage.setItem('arkaios_current_user', JSON.stringify(currentUser));
    updateUserUI();
    loadUserStory();
    alert(`¡Bienvenido a tu Bóveda personal, ${currentUser.name}! Tu progreso ahora se guarda individualmente.`);
  } catch(e) {
    console.error("Error al procesar login de Google", e);
  }
}

function decodeJwt(token) {
  const base64Url = token.split('.')[1];
  const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
  const jsonPayload = decodeURIComponent(atob(base64).split('').map(c => {
    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
  }).join(''));
  return JSON.parse(jsonPayload);
}

function updateUserUI() {
  if (currentUser.id !== "local_guest") {
    document.getElementById('googleBtnContainer').style.display = 'none';
    const badge = document.getElementById('userProfileBadge');
    badge.style.display = 'flex';
    document.getElementById('userProfilePic').src = currentUser.picture;
    document.getElementById('userProfileName').textContent = currentUser.name.split(' ')[0];
    document.getElementById('statUser').textContent = `👤 ${currentUser.name.split(' ')[0]}`;
  }
}

// ── SISTEMA DE DESBLOQUEO ─────────────────────────────────────
function checkUnlocks() {
  if (userState.bondPercent >= 30) {
    unlockItem('unlock1', 'badge1');
  }
  if (userState.bondPercent >= 50) {
    unlockItem('unlock2', 'badge2');
  }
  if (userState.bondPercent >= 75) {
    unlockItem('unlock3', 'badge3');
  }
}

function unlockItem(elemId, badgeId) {
  const el = document.getElementById(elemId);
  const bg = document.getElementById(badgeId);
  if (el) el.classList.remove('locked');
  if (bg) bg.style.display = 'none';
}

function viewUnlock(imgName, title) {
  document.getElementById('mainArt').src = `assets/images/${imgName}`;
}

// ── RENDERIZADO DEL DIÁLOGO ───────────────────────────────────
function applyScene(data, playerChoice) {
  userState.history.push({
    chapter: userState.chapter,
    timestamp: new Date().toISOString(),
    playerChoice: playerChoice,
    narration: data.narration,
    dialogue: data.dialogue,
    bondAfter: userState.bondPercent + (data.bond_change || 0)
  });

  if (data.bond_change) {
    userState.bondPercent = Math.min(userState.bondPercent + data.bond_change, 100);
  }

  updateStatus(data.status_text);
  appendDialog(data, playerChoice);
  renderOptions(data.options);

  userState.chapter++;
  saveUserStory();
}

function updateStatus(statusText) {
  const bondColor = userState.bondPercent > 60 ? 'var(--accent-teal)' : 'var(--accent-amber)';
  document.getElementById('statBond').style.color = bondColor;
  document.getElementById('statBond').textContent = `🛡️ Confianza (${userState.bondPercent}%)`;
  if (statusText) document.getElementById('statStatus').textContent = `☕ ${statusText}`;
}

function appendDialog(data, playerChoice) {
  const box = document.getElementById('dialogLog');
  const msg = document.createElement('div');
  msg.className = 'msg-block';

  let html = `<div class="msg-header"><span>ESCENA ${userState.chapter} // LA BÓVEDA DE LOS FRÁGILES</span></div>`;
  if (playerChoice) {
    html += `<div class="player-quote">▶ <strong>Saúl:</strong> ${escapeHtml(playerChoice)}</div>`;
  }
  html += `<div class="narration">${escapeHtml(data.narration)}</div>`;
  if (data.dialogue) {
    html += `
      <div class="quote-yukiho">
        <div class="speaker-label">🌸 YUKIHO (19 AÑOS)</div>
        ${escapeHtml(data.dialogue)}
      </div>`;
  }

  msg.innerHTML = html;
  box.appendChild(msg);
  box.scrollTop = box.scrollHeight;
}

function renderAllHistory() {
  const box = document.getElementById('dialogLog');
  box.innerHTML = '';
  userState.history.forEach(item => {
    const msg = document.createElement('div');
    msg.className = 'msg-block';
    let html = `<div class="msg-header"><span>ESCENA ${item.chapter} // ${item.timestamp ? new Date(item.timestamp).toLocaleTimeString() : ''}</span></div>`;
    if (item.playerChoice) {
      html += `<div class="player-quote">▶ <strong>Saúl:</strong> ${escapeHtml(item.playerChoice)}</div>`;
    }
    html += `<div class="narration">${escapeHtml(item.narration)}</div>`;
    if (item.dialogue) {
      html += `
        <div class="quote-yukiho">
          <div class="speaker-label">🌸 YUKIHO (19 AÑOS)</div>
          ${escapeHtml(item.dialogue)}
        </div>`;
    }
    msg.innerHTML = html;
    box.appendChild(msg);
  });
  box.scrollTop = box.scrollHeight;
  updateStatus();
}

function renderOptions(opts) {
  const container = document.getElementById('optionsContainer');
  container.innerHTML = '';
  if (!opts || !opts.length) return;

  opts.forEach((opt, idx) => {
    const btn = document.createElement('button');
    btn.className = 'opt-btn';
    btn.innerHTML = `<span class="num">${idx+1}</span> <span>${escapeHtml(opt)}</span>`;
    btn.onclick = () => choose(opt);
    container.appendChild(btn);
  });
}

// ── PROCESAMIENTO CON POLLINATIONS OPENAI ─────────────────────
async function choose(text) {
  if (userState.busy) return;
  setBusy(true);

  try {
    const res = await fetchAI(text);
    applyScene(res, text);
  } catch(err) {
    alert("Error de conexión con la IA. Intenta de nuevo.");
  } finally {
    setBusy(false);
  }
}

function submitCustomAction() {
  const inp = document.getElementById('customInput');
  const val = inp.value.trim();
  if (!val || userState.busy) return;
  inp.value = '';
  choose(val);
}

function setBusy(val) {
  userState.busy = val;
  document.getElementById('btnSend').disabled = val;
  document.querySelectorAll('.opt-btn').forEach(b => b.disabled = val);
}

async function fetchAI(playerText) {
  const messages = [
    { role: 'system', content: SYSTEM_LORE },
    ...userState.history.slice(-4).map(h => ({
      role: 'assistant',
      content: JSON.stringify({ narration: h.narration, dialogue: h.dialogue })
    })),
    {
      role: 'user',
      content: `[Capítulo ${userState.chapter}, Confianza: ${userState.bondPercent}%]\nSaúl responde: "${playerText}"\n\nContinúa la historia en Cancún con respeto y calidez. Responde en JSON estricto.`
    }
  ];

  const res = await fetch('https://text.pollinations.ai/openai/chat/completions', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      messages: messages,
      model: 'openai',
      response_format: { type: 'json_object' }
    })
  });

  if (!res.ok) throw new Error("Fallo en IA");
  const data = await res.json();
  const raw = data.choices[0]?.message?.content || '{}';
  try {
    return JSON.parse(raw.replace(/```json/gi, '').replace(/```/g, '').trim());
  } catch(e) {
    return {
      narration: "Yukiho toma la taza de té caliente con ambas manos, suspirando con alivio mientras la lluvia azota los cristales del balcón en Cancún.",
      dialogue: "«Gracias por cuidarme, Saúl... Por primera vez en mucho tiempo siento que puedo respirar.»",
      bond_change: 10,
      status_text: "Sosteniendo el té caliente",
      options: [
        "Acompañarla en silencio mientras bebe el té caliente.",
        "Ofrecerle cenar algo ligero para recuperar fuerzas.",
        "Preguntarle suavemente si le gustaría hablar de lo que la trajo a Cancún."
      ]
    };
  }
}

// ── EXPEDIENTE Y DESCARGA .LOG ────────────────────────────────
function openUserModal() {
  document.getElementById('modalUserDisplay').textContent = `${currentUser.name} (${currentUser.email})`;
  document.getElementById('modalTurnCount').textContent = `${userState.history.length} escenas completadas`;
  document.getElementById('modalBondDisplay').textContent = `${userState.bondPercent}% de confianza`;
  document.getElementById('userModal').style.display = 'flex';
}

function closeUserModal() {
  document.getElementById('userModal').style.display = 'none';
}

function downloadPlayerLog() {
  const logData = {
    project: "ARKAIOS - La Bóveda de los Frágiles",
    user: currentUser,
    summary: {
      totalScenes: userState.history.length,
      finalBond: userState.bondPercent + "%",
      exportedAt: new Date().toISOString()
    },
    chronicle: userState.history
  };

  const str = JSON.stringify(logData, null, 2);
  const blob = new Blob([str], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `bitacora_yukiho_${currentUser.name.replace(/\s+/g, '_')}_${Date.now()}.log`;
  a.click();
}

function copyPlayerReport() {
  const lines = [
    `=== BITÁCORA ARKAIOS: LA BÓVEDA DE LOS FRÁGILES ===`,
    `Usuario: ${currentUser.name} (${currentUser.email})`,
    `Escenas jugadas: ${userState.history.length}`,
    `Confianza alcanzada: ${userState.bondPercent}%`,
    `Última escena: ${userState.history[userState.history.length - 1]?.narration || ''}`,
    `Últimas palabras de Yukiho: ${userState.history[userState.history.length - 1]?.dialogue || ''}`
  ];
  navigator.clipboard.writeText(lines.join('\n'));
  alert("Resumen de tu bitácora copiado al portapapeles.");
}

function resetCurrentUserStory() {
  if (!confirm(`¿Deseas reiniciar tu progreso personal (${currentUser.name})?`)) return;
  const storeKey = `boveda_fragiles_save_${currentUser.id}`;
  localStorage.removeItem(storeKey);
  userState = { chapter: 1, bondPercent: 20, history: [], busy: false, unlocked: ['yukiho_cover.jpg'] };
  document.getElementById('dialogLog').innerHTML = '';
  applyScene(SCENE_1, null);
  closeUserModal();
}

// ── AUDIO ─────────────────────────────────────────────────────
function toggleRainAudio() {
  const audio = document.getElementById('ambientAudio');
  const txt = document.getElementById('audioTxt');
  const icon = document.getElementById('audioIcon');
  if (audio.paused) {
    audio.play().then(() => {
      txt.textContent = 'Pausar';
      icon.textContent = '🔊';
    }).catch(e => console.warn("Audio blocked", e));
  } else {
    audio.pause();
    txt.textContent = 'Lluvia';
    icon.textContent = '🌧️';
  }
}

function escapeHtml(t) {
  if (!t) return '';
  const d = document.createElement('div');
  d.textContent = t;
  return d.innerHTML;
}
</script>
</body>
</html>
