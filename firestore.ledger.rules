rules_version = '2';
// Base "yukiho-ledger" (solo libro mayor AMR del juego de Yukiho).
// Ningún navegador lee ni escribe aquí: solo /api/wallet y /api/escena con el Admin SDK (que ignora estas reglas).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
